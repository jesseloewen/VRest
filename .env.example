# Absolute path to your video library root
VIDEO_FOLDER=C:/path/to/videos

# Folder where generated thumbnails and previews are stored
DATA_FOLDER=./data

# Flask bind configuration
HOST=0.0.0.0
PORT=3232

# Enable NVIDIA GPU acceleration when available (default true)
USE_GPU=true

# Enable password login protection (default true)
APP_PASSWORD_ENABLED=true

# Password used when APP_PASSWORD_ENABLED is true
APP_PASSWORD=change-me

# Strong random secret used to sign the login session cookie
APP_SECRET_KEY=replace-with-a-long-random-secret

# Performance tuning (optional; defaults are aggressive)
# 0 means ffmpeg auto-selects CPU thread count
FFMPEG_CPU_THREADS=0
THUMBNAIL_MAX_WORKERS=
PREVIEW_MAX_WORKERS=
SCRUB_MAX_WORKERS=

# Speed/quality tradeoff (higher values are usually faster/lower quality)
THUMBNAIL_JPEG_Q=6
SCRUB_JPEG_Q=8
PREVIEW_NVENC_PRESET=p1
PREVIEW_NVENC_CQ=34
PREVIEW_LIBX264_PRESET=ultrafast
PREVIEW_LIBX264_CRF=32
